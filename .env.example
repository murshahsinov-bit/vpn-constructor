# --- Подписки ---
# Секретный ключ для генерации токенов клиентов.
# Сгенерируй случайную строку: python -c "import secrets; print(secrets.token_hex(32))"
SUB_SECRET_KEY=super_secret_key_please_change_me

# Публичный адрес вашего сервиса на Netrun (без /sub/auto.json).
# Точный адрес появится в кабинете Netrun после первой публикации.
# Итоговая ссылка клиента: {NETRUN_BASE_URL}/sub/auto.json?token=...
NETRUN_BASE_URL=https://YOUR-SERVICE.netrun.io

# --- Переменные для Netrun (задаются в кабинете Netrun, не в этом файле) ---
# GITHUB_REPO=USER/REPO
# GITHUB_BRANCH=main
# CONFIG_PATH=web/subscriptions/auto.json
# SUBSCRIPTIONS_DIR=web/subscriptions
# GITHUB_TOKEN=github_pat_...        # нужен, если репозиторий приватный
# CLIENTS_JSON={"clients":[...]}     # альтернатива файлу clients.json
# CACHE_TTL=60

# --- HTTP-заголовки подписки (Happ + INCY) ---
# profile-title, максимум 25 символов.
# PROFILE_TITLE=VPN Constructor
# PROFILE_UPDATE_INTERVAL=1
# SUBSCRIPTION_TOTAL_BYTES=107374182400
# PROFILE_WEB_PAGE_URL=https://example.com/tariff
# SUPPORT_URL=https://t.me/your_support
# HIDE_URL=1
# SUBSCRIPTION_ALWAYS_HWID_ENABLE=1
# NO_LIMIT_XHTTP_ENABLED=1
# SUB_EXPIRE_DAYS=3
# SUB_EXPIRE_BUTTON_LINK=https://t.me/your_bot
# SUB_EXPIRE_TEXT=Подписка истекает {date}. Продлите вовремя.
# SUB_EXPIRE_ANNOUNCE=1

# --- WebRTC (экспериментальный ручной профиль) ---
# WEBRTC_SOCKS5=socks5://user:pass@host:1080
