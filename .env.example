# --- Telegram ---
BOT_TOKEN=123456789:AAH...
ADMIN_IDS=123456789,987654321

# --- База данных (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./vpn_bot.db

# --- Подписки ---
SUB_SECRET_KEY=super_secret_key_please_change_me
