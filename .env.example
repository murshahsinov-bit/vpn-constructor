# --- Cloudflare (если используешь experimental/cloudflare_workers) ---
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id

# --- GitHub (для Codespaces relay) ---
GITHUB_TOKEN=ghp_your_github_token