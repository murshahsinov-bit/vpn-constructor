{
  "log": { "loglevel": "warning" },
  "dns": {
    "servers": ["1.1.1.1", "8.8.8.8"]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": { "udp": true },
      "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] }
    }
  ],
  "outbounds": [],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "type": "field", "ip": ["geoip:private", "geoip:ru"], "outboundTag": "direct" },
      { "type": "field", "domain": ["geosite:category-ru", "geosite:private"], "outboundTag": "direct" },
      { "type": "field", "network": "tcp,udp", "balancerTag": "auto-balancer" }
    ],
    "balancers": [
      {
        "tag": "auto-balancer",
        "selector": ["proxy-"],
        "strategy": { "type": "leastLoad", "settings": { "expected": 2, "maxRTT": "1500ms", "tolerance": 0.4 } },
        "fallbackTag": "direct"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": ["proxy-"],
    "pingConfig": {
      "destination": "https://www.gstatic.com/generate_204",
      "connectivity": "https://www.gstatic.com/generate_204",
      "interval": "10s",
      "sampling": 3,
      "timeout": "5s",
      "httpMethod": "HEAD"
    }
  },
  "meta": { "serverDescription": "🤖 Умный Авто" },
  "stats": {}
}