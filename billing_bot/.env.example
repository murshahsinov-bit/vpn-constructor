# Токен бота из @BotFather
BOT_TOKEN=

# Адрес воркера подписок (тот же, что в приложении)
PUBLIC_BASE_URL=https://vpn-auth.de1.netrun.io

# Должен совпадать с ADMIN_TOKEN воркера: через него бот выдаёт лицензии
ADMIN_TOKEN=

# Ссылки, которые бот показывает пользователю
APK_URL=https://github.com/murshahsinov-bit/vpn-constructor/releases/latest
HAPP_ANDROID_URL=https://happ.su
INCY_URL=https://happ.su
SUPPORT_URL=

# Куда складывать номера обработанных платежей
PAYMENTS_FILE=data/payments.json
