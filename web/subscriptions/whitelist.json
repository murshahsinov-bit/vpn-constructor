{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "77.88.8.8",
      "1.1.1.1"
    ]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "wl-proxy-1",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "168.113.128.70",
            "port": 20105,
            "users": [
              {
                "id": "9aff658c-1f80-4c82-9213-48ca26996142",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "sockopt": {
          "tcpFastOpen": true,
          "tcpMss": 1440,
          "tcpcongestion": "bbr",
          "domainStrategy": "UseIP"
        },
        "fragment": {
          "packets": "tlshello",
          "length": "100-200",
          "interval": "10-20"
        },
        "tlsSettings": {
          "serverName": "ripelever.net",
          "fingerprint": "chrome"
        }
      },
      "mux": {
        "enabled": true,
        "concurrency": 16,
        "xudpConcurrency": 16
      }
    },
    {
      "tag": "wl-proxy-2",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "lorettmay.top",
            "port": 443,
            "users": [
              {
                "id": "2232d904-8e6a-4202-8240-6efd8aec02e9",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "sockopt": {
          "tcpFastOpen": true,
          "tcpMss": 1440,
          "tcpcongestion": "bbr",
          "domainStrategy": "UseIP"
        },
        "fragment": {
          "packets": "tlshello",
          "length": "100-200",
          "interval": "10-20"
        },
        "tlsSettings": {
          "serverName": "lorettmay.top",
          "fingerprint": "chrome"
        },
        "wsSettings": {
          "path": "/blog/posts",
          "headers": {
            "Host": ""
          }
        }
      },
      "mux": {
        "enabled": true,
        "concurrency": 16,
        "xudpConcurrency": 16
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "whitelist-balancer"
      }
    ],
    "balancers": [
      {
        "tag": "whitelist-balancer",
        "selector": [
          "wl-proxy-1",
          "wl-proxy-2"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "fallbackTag": "direct"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": [
      "wl-proxy-1",
      "wl-proxy-2"
    ],
    "pingConfig": {
      "destination": "http://cp.cloudflare.com/generate_204",
      "interval": "30s",
      "sampling": 2,
      "timeout": "5s"
    }
  },
  "meta": {
    "serverDescription": "🛡️ Обход Белых Списков"
  },
  "stats": {}
}